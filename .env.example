APP_NAME=RepoRecall API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://reporecall:reporecall@postgres:5432/reporecall
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=engineering_history

# Optional for public repositories, but strongly recommended to avoid low unauthenticated limits.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_MAX_ITEMS_PER_SOURCE=100
WORKER_POLL_INTERVAL_SECONDS=3

# Required only for evidence-grounded answer generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b
